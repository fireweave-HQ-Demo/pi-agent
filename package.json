{
  "name": "pr-decision-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi extension and CLI that run skill.md and score answers with the skill.md graph.",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/test/*.test.js",
    "analyze": "tsc && node dist/src/cli.js",
    "e2e:scripted": "tsc && node dist/src/cli.js --scripted"
  },
  "bin": {
    "analyze-pr": "dist/src/cli.js"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "keywords": [
    "pi-package"
  ],
  "dependencies": {
    "typebox": "^1.3.36"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
