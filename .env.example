# Cursor key used by cursor-agent and by pi-cursor-auth. Never commit the real value.
CURSOR_API_KEY=

# Optional. Needed for private GitHub repos. Public pull requests clone without it.
GITHUB_TOKEN=

# Optional. cursor-agent model id. Default is composer-2.5-fast.
# CURSOR_MODEL=composer-2.5-fast

# FireWeave remote flag evaluation — issue keys in the project settings portal
FIREWEAVE_KEY=
