# Cursor key used by cursor-agent and by pi-cursor-auth. Never commit the real value.
CURSOR_API_KEY=

# GitHub token. Read the same way as CURSOR_API_KEY. Never commit the real value.
# Pull request write access is required to post the review comment.
# Also used to clone private repositories.
GITHUB_TOKEN=

# Optional. cursor-agent model id. Default is composer-2.5-fast.
# CURSOR_MODEL=composer-2.5-fast
